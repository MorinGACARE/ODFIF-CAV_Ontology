        <rdfs:label>Transparency</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#UltrasonicSensor -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#UltrasonicSensor">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Sensor"/>
        <rdfs:comment>Acoustic wave sensor utilized for short-range parking maneuvers.</rdfs:comment>
        <rdfs:label>Ultrasonic Sensor</rdfs:label>
    </owl:Class>
    


