        <rdfs:label>Subsystem</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#SuspensionActuator -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#SuspensionActuator">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Actuator"/>
