        <isControlledBy rdf:resource="http://www.example.org/cav-df-ontology#MainDomainController"/>
        <hasDescription>Electro-hydraulic braking actuator controlling caliper pressure.</hasDescription>
        <rdfs:label>BrakingActuator1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.example.org/cav-df-ontology#CAN_Braking_Log -->

