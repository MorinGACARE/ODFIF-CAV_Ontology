    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#ThrottleActuator -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#ThrottleActuator">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Actuator"/>
        <rdfs:comment>Electronic throttle control actuator managing engine or motor propulsion torque.</rdfs:comment>
        <rdfs:label>Throttle Actuator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#TimelineAnalysis -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#TimelineAnalysis">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#AnalysisMethod"/>
        <rdfs:comment>Methodology reconstructing chronological sequences across internal bus traces and V2X PCAPs.</rdfs:comment>
        <rdfs:label>Timeline &amp; Clock Synchronization Analysis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#TrafficControlCenter_ITC -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#TrafficControlCenter_ITC">
