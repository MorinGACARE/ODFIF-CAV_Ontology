        <hasHashValue>a8f5f167f44f4964e6c998dee827110c</hasHashValue>
        <hasTimestamp rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2026-03-15T10:30:00.000Z</hasTimestamp>
        <hasValidity rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</hasValidity>
        <rdfs:label>CAN_Braking_Log</rdfs:label>
    </owl:NamedIndividual>
    


