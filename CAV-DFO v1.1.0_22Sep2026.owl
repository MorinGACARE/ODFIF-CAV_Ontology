<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/cav-df-ontology#"
     xml:base="http://www.example.org/cav-df-ontology"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:cav="http://www.example.org/cav-df-ontology#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.example.org/cav-df-ontology">
        <owl:versionIRI rdf:resource="http://www.example.org/cav-df-ontology/1.1.0"/>
        <dc:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">24/11/2026</dc:created>
        <dc:description>A comprehensive OWL/RDF-XML ontology for digital forensics in Connected Autonomous Vehicles (CAVs). Aligned with ISO/IEC 27037, ISO/SAE 21434, ISO 34503, and NIST SP 800-86. It structures concepts across Actor, Data Sources, Evidence Correlation, Incident, and Legal/Ethical sub-domains with full V2X, cybersecurity, and internal architecture coverage.</dc:description>
        <dc:title>Connected Autonomous Vehicles Digital Forensics Ontology (CAV-DFO)</dc:title>
        <dc:title>Oluwaseun Abimibola (Bimbo) Bakare</dc:title>
        <owl:versionInfo>v1.1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/created"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.example.org/cav-df-ontology#analysedBy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#analysedBy">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#analyses"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#AnalysisMethod"/>
        <rdfs:comment>Relates digital evidence to the specific analysis method used to examine it.</rdfs:comment>
        <rdfs:label>analysedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#analyses -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#analyses">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#AnalysisMethod"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
        <rdfs:comment>Inverse of analysedBy.</rdfs:comment>
        <rdfs:label>analyses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#appliesTo -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#appliesTo">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isAppliedTo"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#EthicalPrinciple"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#LegalRequirement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#Actor"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#Incident"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Relates legal or ethical constraints to an incident, piece of evidence, or actor.</rdfs:comment>
        <rdfs:label>appliesTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#assists -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#assists">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isAssistedBy"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#Actor"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#Actor"/>
        <rdfs:comment>Indicates one actor aiding another during or after an incident.</rdfs:comment>
        <rdfs:label>assists</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#causedBy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#causedBy">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#causes"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#Incident"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#Actor"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#CybersecurityEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Causal link between an incident and its contributing actor, cyber event, or hardware failure.</rdfs:comment>
        <rdfs:label>causedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#causes -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#causes">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#Actor"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#CybersecurityEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#Incident"/>
        <rdfs:comment>Inverse of causedBy.</rdfs:comment>
        <rdfs:label>causes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#commands -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#commands">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isCommandedBy"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#ECU"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#Actuator"/>
        <rdfs:comment>Relates an ECU sending control signals to physical actuators.</rdfs:comment>
        <rdfs:label>commands</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#communicatesVia -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#communicatesVia">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isCommunicationProtocolFor"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#CommunicationProtocol"/>
        <rdfs:comment>Specifies the network bus or wireless protocol used by a component.</rdfs:comment>
        <rdfs:label>communicatesVia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#contains -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#contains">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#storedIn"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#DataStorageSystem"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#DataFile"/>
        <rdfs:comment>Indicates a storage system holding a data file or log.</rdfs:comment>
        <rdfs:label>contains</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#controls -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#controls">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isControlledBy"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#Driver"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#ECU"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#Actuator"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#VehicleSystem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Relates an operator or controller to controlled hardware components.</rdfs:comment>
        <rdfs:label>controls</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#directlyCausedBy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#directlyCausedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/cav-df-ontology#causedBy"/>
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#directlyCauses"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#CyberAttack"/>
        <rdfs:comment>Direct causal relation between an incident and an offensive cyber attack.</rdfs:comment>
        <rdfs:label>directlyCausedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#directlyCauses -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#directlyCauses">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/cav-df-ontology#causes"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#CyberAttack"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#Incident"/>
        <rdfs:comment>Inverse of directlyCausedBy.</rdfs:comment>
        <rdfs:label>directlyCauses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#ensures -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#ensures">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isEnsuredBy"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#ChainOfCustody"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#ForensicTool"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#EvidenceIntegrity"/>
        <rdfs:comment>Relates forensic tools or processes to preserved evidence integrity.</rdfs:comment>
        <rdfs:label>ensures</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#generates -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#generates">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isAcquiredFrom"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#DataSource"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#DataFile"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Indicates a source producing data logs or digital evidence.</rdfs:comment>
        <rdfs:label>generates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasAttackVector -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#hasAttackVector">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isAttackVectorOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#CyberAttack"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#AttackVector"/>
        <rdfs:comment>Links a cyber attack to its underlying attack vector.</rdfs:comment>
        <rdfs:label>hasAttackVector</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasComponent -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#hasComponent">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isComponentOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:comment>Structural decomposition relation between system elements.</rdfs:comment>
        <rdfs:label>hasComponent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasDataSource -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#hasDataSource">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isDataSourceOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#DataSource"/>
        <rdfs:comment>Associates a component with its embedded data source.</rdfs:comment>
        <rdfs:label>hasDataSource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasDriver -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#hasDriver">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isDriverOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#VehicleSystem"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#Driver"/>
        <rdfs:comment>Inverse of isDriverOf.</rdfs:comment>
        <rdfs:label>hasDriver</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasEvidence -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#hasEvidence">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isEvidenceOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
        <rdfs:comment>Links an incident to discovered digital evidence.</rdfs:comment>
        <rdfs:label>hasEvidence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasIncident -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#hasIncident">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isIncidentOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#VehicleSystem"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#Incident"/>
        <rdfs:comment>Relates a vehicle to an incident in which it was involved.</rdfs:comment>
        <rdfs:label>hasIncident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasOccupants -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#hasOccupants">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isOccupantOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#VehicleSystem"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#Occupant"/>
        <rdfs:comment>Identifies occupants present inside a vehicle.</rdfs:comment>
        <rdfs:label>hasOccupants</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasPart -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#hasPart">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isPartOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:comment>Part-whole relationship among hardware or software objects.</rdfs:comment>
        <rdfs:label>hasPart</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasSubject -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#hasSubject">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#isSubjectTo"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#CybersecurityEvent"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:comment>Inverse of isSubjectTo.</rdfs:comment>
        <rdfs:label>hasSubject</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isAcquiredFrom -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isAcquiredFrom">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#DataSource"/>
        <rdfs:comment>Inverse of generates.</rdfs:comment>
        <rdfs:label>isAcquiredFrom</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isAppliedTo -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isAppliedTo">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#Actor"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#Incident"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#EthicalPrinciple"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#LegalRequirement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Inverse of appliesTo.</rdfs:comment>
        <rdfs:label>isAppliedTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isAssistedBy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isAssistedBy">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#Actor"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#Actor"/>
        <rdfs:comment>Inverse of assists.</rdfs:comment>
        <rdfs:label>isAssistedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isAttackVectorOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isAttackVectorOf">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#AttackVector"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#CyberAttack"/>
        <rdfs:comment>Inverse of hasAttackVector.</rdfs:comment>
        <rdfs:label>isAttackVectorOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isCommandedBy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isCommandedBy">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#Actuator"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#ECU"/>
        <rdfs:comment>Inverse of commands.</rdfs:comment>
        <rdfs:label>isCommandedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isCommunicationProtocolFor -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isCommunicationProtocolFor">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#CommunicationProtocol"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:comment>Inverse of communicatesVia.</rdfs:comment>
        <rdfs:label>isCommunicationProtocolFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isComponentOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isComponentOf">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:comment>Inverse of hasComponent.</rdfs:comment>
        <rdfs:label>isComponentOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isControlledBy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isControlledBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#Actuator"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#VehicleSystem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#Driver"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#ECU"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Inverse of controls.</rdfs:comment>
        <rdfs:label>isControlledBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isDataSourceOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isDataSourceOf">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#DataSource"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:comment>Inverse of hasDataSource.</rdfs:comment>
        <rdfs:label>isDataSourceOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isDriverOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isDriverOf">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#Driver"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#VehicleSystem"/>
        <rdfs:comment>Associates a human driver with the operated vehicle.</rdfs:comment>
        <rdfs:label>isDriverOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isEnsuredBy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isEnsuredBy">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#EvidenceIntegrity"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#ChainOfCustody"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#ForensicTool"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Inverse of ensures.</rdfs:comment>
        <rdfs:label>isEnsuredBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isEvidenceOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isEvidenceOf">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#Incident"/>
        <rdfs:comment>Inverse of hasEvidence.</rdfs:comment>
        <rdfs:label>isEvidenceOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isIncidentOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isIncidentOf">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#VehicleSystem"/>
        <rdfs:comment>Inverse of hasIncident.</rdfs:comment>
        <rdfs:label>isIncidentOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isOccupantOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isOccupantOf">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#Occupant"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#VehicleSystem"/>
        <rdfs:comment>Inverse of hasOccupants.</rdfs:comment>
        <rdfs:label>isOccupantOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isPartOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isPartOf">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:comment>Inverse of hasPart.</rdfs:comment>
        <rdfs:label>isPartOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isRecordedBy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isRecordedBy">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#records"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#DataLog"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#DataStorageSystem"/>
        <rdfs:comment>Inverse of records.</rdfs:comment>
        <rdfs:label>isRecordedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isSubjectTo -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isSubjectTo">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#CybersecurityEvent"/>
        <rdfs:comment>Identifies a component targeted by a cyber event.</rdfs:comment>
        <rdfs:label>isSubjectTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isSupportedBy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isSupportedBy">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#supports"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#Assertion"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
        <rdfs:comment>Links a report assertion to supporting digital evidence.</rdfs:comment>
        <rdfs:label>isSupportedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isUsedBy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#isUsedBy">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#uses"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#ForensicTool"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#Investigator"/>
        <rdfs:comment>Inverse of uses.</rdfs:comment>
        <rdfs:label>isUsedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#providesDataTo -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#providesDataTo">
        <owl:inverseOf rdf:resource="http://www.example.org/cav-df-ontology#receivesDataFrom"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#Sensor"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#ECU"/>
        <rdfs:comment>Data flow path from sensors to processing ECUs.</rdfs:comment>
        <rdfs:label>providesDataTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#receivesDataFrom -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#receivesDataFrom">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#ECU"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#Sensor"/>
        <rdfs:comment>Inverse of providesDataTo.</rdfs:comment>
        <rdfs:label>receivesDataFrom</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#records -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#records">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#DataStorageSystem"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#DataLog"/>
        <rdfs:comment>Relates logging hardware to generated data logs.</rdfs:comment>
        <rdfs:label>records</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#relatedTo -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#relatedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
        <rdfs:comment>Symmetric relationship asserting general correlation between evidence items.</rdfs:comment>
        <rdfs:label>relatedTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#storedIn -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#storedIn">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#DataFile"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#DataStorageSystem"/>
        <rdfs:comment>Inverse of contains.</rdfs:comment>
        <rdfs:label>storedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#supports -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#supports">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#Assertion"/>
        <rdfs:comment>Inverse of isSupportedBy.</rdfs:comment>
        <rdfs:label>supports</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/cav-df-ontology#uses -->

    <owl:ObjectProperty rdf:about="http://www.example.org/cav-df-ontology#uses">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#Investigator"/>
        <rdfs:range rdf:resource="http://www.example.org/cav-df-ontology#ForensicTool"/>
        <rdfs:comment>Relates a forensic investigator to tools deployed in analysis.</rdfs:comment>
        <rdfs:label>uses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.example.org/cav-df-ontology#hasConfidenceLevel -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/cav-df-ontology#hasConfidenceLevel">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#Assertion"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Statistical confidence score (0.0 to 1.0) associated with perception objects or forensic assertions.</rdfs:comment>
        <rdfs:label>hasConfidenceLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasDataFormat -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/cav-df-ontology#hasDataFormat">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#DataFile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Encoding format of stored logs (e.g., PCAP, CAN-DBC, Protobuf, JSON, CSV, HDF5).</rdfs:comment>
        <rdfs:label>hasDataFormat</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasDescription -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/cav-df-ontology#hasDescription">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Textual comment or descriptive narrative associated with an instance or class.</rdfs:comment>
        <rdfs:label>hasDescription</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasHashValue -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/cav-df-ontology#hasHashValue">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Cryptographic hash value (SHA-256 or SHA-512) for evidence integrity validation.</rdfs:comment>
        <rdfs:label>hasHashValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasLocation -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/cav-df-ontology#hasLocation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#Incident"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Geospatial coordinates (WGS84 Lat/Long) or localized physical installation position.</rdfs:comment>
        <rdfs:label>hasLocation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasSeverity -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/cav-df-ontology#hasSeverity">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#CybersecurityEvent"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#Incident"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Severity categorization (Critical, High, Medium, Low) under ISO/SAE 21434 threat rating.</rdfs:comment>
        <rdfs:label>hasSeverity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasSpeed -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/cav-df-ontology#hasSpeed">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#VehicleSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Instantaneous speed metric expressed in meters per second (m/s) or km/h.</rdfs:comment>
        <rdfs:label>hasSpeed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasTimestamp -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/cav-df-ontology#hasTimestamp">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#CybersecurityEvent"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#Incident"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment>UTC synchronized timestamp formatted under ISO 8601 (e.g., 2026-03-15T10:30:00.000Z).</rdfs:comment>
        <rdfs:label>hasTimestamp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasValidity -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/cav-df-ontology#hasValidity">
        <rdfs:domain rdf:resource="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Boolean flag confirming whether evidence passed PKI signature verification or checksum checks.</rdfs:comment>
        <rdfs:label>hasValidity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/cav-df-ontology#hasVersion -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/cav-df-ontology#hasVersion">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#DataFile"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Firmware, software, map database, or API protocol version string.</rdfs:comment>
        <rdfs:label>hasVersion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/cav-df-ontology#isLegallyAdmissible -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/cav-df-ontology#isLegallyAdmissible">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
                    <rdf:Description rdf:about="http://www.example.org/cav-df-ontology#ForensicReport"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Boolean indicator of compliance with legal chain-of-custody and evidence standards.</rdfs:comment>
        <rdfs:label>isLegallyAdmissible</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.example.org/cav-df-ontology#AVSystemComponent -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#AVSystemComponent">
        <rdfs:comment>Hardware or software modules comprising the connected autonomous vehicle system.</rdfs:comment>
        <rdfs:label>AV System Component</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Accountability -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Accountability">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#EthicalPrinciple"/>
        <rdfs:comment>Obligation of OEMs, operators, or drivers to accept responsibility for automated decisions.</rdfs:comment>
        <rdfs:label>Accountability</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Actor -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Actor">
        <rdfs:comment>A general category for any human or organizational entity interacting with or involved in a CAV incident.</rdfs:comment>
        <rdfs:label>Actor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Actuator -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Actuator">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:comment>Actuators in autonomous vehicles convert electronic signals into physical motion (steering, braking, throttle).</rdfs:comment>
        <rdfs:label>Actuator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Adversary -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Adversary">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Actor"/>
        <rdfs:comment>An entity (e.g., hacker group, threat actor) that intentionally compromises or exploits CAV systems or V2X infrastructure.</rdfs:comment>
        <rdfs:label>Adversary</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#AnalysisMethod -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#AnalysisMethod">
        <rdfs:comment>Scientific procedure applied to process and evaluate CAV evidence.</rdfs:comment>
        <rdfs:label>Analysis Method</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Assertion -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Assertion">
        <rdfs:comment>A claim or hypothesis in an expert forensic report requiring multi-source corroboration.</rdfs:comment>
        <rdfs:label>Forensic Assertion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#AttackVector -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#AttackVector">
        <rdfs:comment>Pathways exploited to access vehicle networks (TCU, OBD-II, Wi-Fi, V2X PC5, OTA server).</rdfs:comment>
        <rdfs:label>Attack Vector</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#BasicSafetyMessage_BSM -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#BasicSafetyMessage_BSM">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#V2XMessage"/>
        <rdfs:comment>SAE J2735 message broadcasting core vehicle position, speed, heading, and braking status.</rdfs:comment>
        <rdfs:label>Basic Safety Message (BSM)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#BlackBox -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#BlackBox">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#DataStorageSystem"/>
        <rdfs:comment>Generic term for hardened on-board multi-channel telemetry recorders.</rdfs:comment>
        <rdfs:label>Black Box</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#BrakingActuator -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#BrakingActuator">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Actuator"/>
        <rdfs:comment>Electro-hydraulic or electro-mechanical braking actuator executing longitudinal deceleration.</rdfs:comment>
        <rdfs:label>Braking Actuator (ESP/EHB)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#ByStander -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#ByStander">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Actor"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#Driver"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#FirstResponder"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#Occupant"/>
        <rdfs:comment>An individual present near the scene who is not a vehicle occupant or perpetrator.</rdfs:comment>
        <rdfs:label>ByStander</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#CANBus -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#CANBus">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#CommunicationProtocol"/>
        <rdfs:comment>Controller Area Network protocol for localized ECU frame exchange.</rdfs:comment>
        <rdfs:label>CAN / CAN-FD Bus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#CAN_Frame_Injection -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#CAN_Frame_Injection">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#CyberAttack"/>
        <rdfs:comment>Unauthorized injection of validly formatted CAN frames onto internal vehicle buses.</rdfs:comment>
        <rdfs:label>CAN Bus Frame Injection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#CameraSensor -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#CameraSensor">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Sensor"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#LidarSensor"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#RadarSensor"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#UltrasonicSensor"/>
        <rdfs:comment>Optical perception sensor capturing visual frames for object classification and lane keeping.</rdfs:comment>
        <rdfs:label>Camera Sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#CellularBaseStation_5G_gNB -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#CellularBaseStation_5G_gNB">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#ExternalDataSource"/>
        <rdfs:comment>Telecom infrastructure hosting C-V2X Uu interface logs and cellular timing records.</rdfs:comment>
        <rdfs:label>Cellular Base Station (5G gNB)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#CertificateRevocationList_CRL -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#CertificateRevocationList_CRL">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#ExternalDataSource"/>
        <rdfs:comment>Database of revoked V2X certificates used to verify message authenticity.</rdfs:comment>
        <rdfs:label>Certificate Revocation List (CRL)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#ChainOfCustody -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#ChainOfCustody">
        <rdfs:comment>Documentation tracking evidence acquisition, transfer, and analysis under ISO/IEC 27037.</rdfs:comment>
        <rdfs:label>Chain of Custody</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#CollectivePerception_CPM -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#CollectivePerception_CPM">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#V2XMessage"/>
        <rdfs:comment>Message sharing sensor-detected obstacles with surrounding non-line-of-sight vehicles.</rdfs:comment>
        <rdfs:label>Collective Perception Message (CPM)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#CommunicationProtocol -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#CommunicationProtocol">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:comment>Rules governing data exchange across internal buses or external wireless interfaces.</rdfs:comment>
        <rdfs:label>Communication Protocol</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Consent -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Consent">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#LegalRequirement"/>
        <rdfs:comment>Legal consent or search warrant permissions authorizing extraction of storage media.</rdfs:comment>
        <rdfs:label>Consent &amp; Authorization</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#CooperativeAwarenessMessage_CAM -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#CooperativeAwarenessMessage_CAM">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#V2XMessage"/>
        <rdfs:comment>ETSI EN 302 637-2 message broadcasting vehicle state and dimension metrics.</rdfs:comment>
        <rdfs:label>Cooperative Awareness Message (CAM)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#CyberAttack -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#CyberAttack">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#CybersecurityEvent"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#PhysicalIncident"/>
        <rdfs:comment>Deliberate attempt to exploit, corrupt, or manipulate CAV electronics or automated decisions.</rdfs:comment>
        <rdfs:label>Cyber Attack</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#CybersecurityEvent -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#CybersecurityEvent">
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#NonCyberIncident"/>
        <rdfs:comment>Observable occurrence in vehicle networks or wireless links impacting security under ISO/SAE 21434.</rdfs:comment>
        <rdfs:label>Cybersecurity Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#DSSAD -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#DSSAD">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#DataStorageSystem"/>
        <rdfs:comment>Mandatory log mechanism recording automated mode engagement, TORs, and takeover timestamps.</rdfs:comment>
        <rdfs:label>Data Storage System for Automated Driving (DSSAD)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#DataFile -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#DataFile">
        <rdfs:comment>A structured digital container housing recorded vehicle or network data.</rdfs:comment>
        <rdfs:label>Data File</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#DataLog -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#DataLog">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#DataFile"/>
        <rdfs:comment>Sequential execution or state records emitted by vehicle controllers or software layers.</rdfs:comment>
        <rdfs:label>Data Log</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#DataPrivacyRegulation -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#DataPrivacyRegulation">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#LegalRequirement"/>
        <rdfs:comment>Statutes protecting PII extracted from cabin video, DMS, or location histories (GDPR/CCPA).</rdfs:comment>
        <rdfs:label>Data Privacy Regulation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#DataSource -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#DataSource">
        <rdfs:comment>Any physical or logical system generating, storing, or transmitting data relevant to a CAV investigation.</rdfs:comment>
        <rdfs:label>Data Source</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#DataStorageSystem -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#DataStorageSystem">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:comment>Memory media maintaining volatile or non-volatile logs within the CAV platform.</rdfs:comment>
        <rdfs:label>Data Storage System</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#DecentralizedEnvironmentalNotification_DENM -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#DecentralizedEnvironmentalNotification_DENM">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#V2XMessage"/>
        <rdfs:comment>ETSI message notifying surrounding vehicles of hazardous road events or hard braking.</rdfs:comment>
        <rdfs:label>Decentralized Environmental Notification (DENM)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#DenialOfService -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#DenialOfService">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#CyberAttack"/>
        <rdfs:comment>Attack exhausting bus bandwidth or wireless spectrum, delaying safety frames.</rdfs:comment>
        <rdfs:label>Denial of Service (DoS / DDoS)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#DigitalEvidence -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#DigitalEvidence">
        <rdfs:comment>Probative binary information extracted from CAV hardware, networks, or cloud endpoints.</rdfs:comment>
        <rdfs:label>Digital Evidence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Driver -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Driver">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Actor"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#FirstResponder"/>
        <rdfs:comment>The human operator of a CAV who oversees automated driving modes or assumes manual control.</rdfs:comment>
        <rdfs:label>Driver</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#ECU -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#ECU">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#InternalDataSource"/>
        <rdfs:comment>Embedded microcontrollers executing localized sensor fusion, domain control, or actuation commands.</rdfs:comment>
        <rdfs:label>Electronic Control Unit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Ethernet -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Ethernet">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#CommunicationProtocol"/>
        <rdfs:comment>High-speed networking protocol (SOME/IP, DoIP) for camera feeds and domain controller messaging.</rdfs:comment>
        <rdfs:label>Automotive Ethernet</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#EthicalPrinciple -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#EthicalPrinciple">
        <rdfs:comment>Moral standards guiding algorithm choices, fallback behaviors, and investigator impartiality.</rdfs:comment>
        <rdfs:label>Ethical Principle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#EventDataRecorder -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#EventDataRecorder">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#DataStorageSystem"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#InfotainmentSystem"/>
        <rdfs:comment>Crash-hardened module recording pre- and post-impact crash telemetry.</rdfs:comment>
        <rdfs:label>Event Data Recorder (EDR)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#EvidenceIntegrity -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#EvidenceIntegrity">
        <rdfs:comment>Assurance that digital evidence remains unaltered (verified via cryptographic hashes).</rdfs:comment>
        <rdfs:label>Evidence Integrity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#ExculpatoryEvidence -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#ExculpatoryEvidence">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#InculpatoryEvidence"/>
        <rdfs:comment>Digital artifacts clearing an actor or subsystem of fault, demonstrating external causation.</rdfs:comment>
        <rdfs:label>Exculpatory Evidence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#ExternalDataSource -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#ExternalDataSource">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#DataSource"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#InternalDataSource"/>
        <rdfs:comment>Data sources outside the vehicle (RSUs, cellular towers, PKI servers, cloud centers).</rdfs:comment>
        <rdfs:label>External Data Source</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Fairness -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Fairness">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#EthicalPrinciple"/>
        <rdfs:comment>Equitable risk allocation during crash avoidance maneuvers and unbiased forensic evaluation.</rdfs:comment>
        <rdfs:label>Fairness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#FirstAider -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#FirstAider">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#FirstResponder"/>
        <rdfs:comment>Medical personnel providing immediate triage and treatment at the incident scene.</rdfs:comment>
        <rdfs:label>First Aider</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#FirstResponder -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#FirstResponder">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Actor"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#Occupant"/>
        <rdfs:comment>Emergency personnel arriving at an incident scene to render aid or secure the area.</rdfs:comment>
        <rdfs:label>First Responder</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#ForensicReport -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#ForensicReport">
        <rdfs:comment>Formal legal document detailing findings, methodologies, and multi-source corroborations.</rdfs:comment>
        <rdfs:label>Forensic Report</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#ForensicTool -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#ForensicTool">
        <rdfs:comment>Hardware or software deployed to acquire or parse CAV evidence in a forensically sound manner.</rdfs:comment>
        <rdfs:label>Forensic Tool</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#GNSS_Jamming -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#GNSS_Jamming">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#CyberAttack"/>
        <rdfs:comment>High-power RF interference overwhelming satellite reception on 1.5 GHz / 1.2 GHz bands.</rdfs:comment>
        <rdfs:label>GNSS / GPS Jamming Attack</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#GNSS_SatelliteConstellation -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#GNSS_SatelliteConstellation">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#ExternalDataSource"/>
        <rdfs:comment>External positioning satellite infrastructure broadcasting atomic timing and ephemeris data.</rdfs:comment>
        <rdfs:label>GNSS Satellite Constellation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#GNSS_Spoofing -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#GNSS_Spoofing">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#CyberAttack"/>
        <rdfs:comment>Broadcasting forged satellite signals to manipulate vehicle location and time sync.</rdfs:comment>
        <rdfs:label>GNSS / GPS Spoofing Attack</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#GPSReceiver -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#GPSReceiver">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Sensor"/>
        <rdfs:comment>Satellite positioning receiver calculating geospatial coordinates and time synchronization.</rdfs:comment>
        <rdfs:label>GNSS / GPS Receiver</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#GearShiftActuator -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#GearShiftActuator">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Actuator"/>
        <rdfs:comment>Electronic transmission actuator executing shift-by-wire commands.</rdfs:comment>
        <rdfs:label>Gear Shift Actuator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#HIL_SIL_Simulation -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#HIL_SIL_Simulation">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#AnalysisMethod"/>
        <rdfs:comment>Replaying recorded sensor dumps through HIL/SIL test benches to test planner response determinism.</rdfs:comment>
        <rdfs:label>Hardware/Software-in-the-Loop Simulation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#HMI -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#HMI">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:comment>Displays and chimes communicating driving modes and takeover prompts to human operators.</rdfs:comment>
        <rdfs:label>Human-Machine Interface (HMI)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Incident -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Incident">
        <rdfs:comment>An occurrence leading to physical damage, injury, operational compromise, or safety hazard.</rdfs:comment>
        <rdfs:label>Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#InculpatoryEvidence -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#InculpatoryEvidence">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#DigitalEvidence"/>
        <rdfs:comment>Digital artifacts establishing fault, liability, or malicious involvement.</rdfs:comment>
        <rdfs:label>Inculpatory Evidence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#InertialMeasurementUnit_IMU -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#InertialMeasurementUnit_IMU">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Sensor"/>
        <rdfs:comment>Sensor cluster measuring 3-axis angular velocity and linear acceleration for dead-reckoning.</rdfs:comment>
        <rdfs:label>Inertial Measurement Unit (IMU)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#InfotainmentSystem -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#InfotainmentSystem">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:comment>In-vehicle system managing mobile pairing, navigation maps, and user connectivity.</rdfs:comment>
        <rdfs:label>Infotainment / Telematics Unit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#InternalDataSource -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#InternalDataSource">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#DataSource"/>
        <rdfs:comment>Data sources located physically within the CAV bus and ECU architecture.</rdfs:comment>
        <rdfs:label>Internal Data Source</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#IntersectionMAP_MAP -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#IntersectionMAP_MAP">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#V2XMessage"/>
        <rdfs:comment>V2I message broadcasting physical lane geometry and lane connection attributes.</rdfs:comment>
        <rdfs:label>Intersection MAP Message</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#IntrusionDetectionSystem_IDPS -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#IntrusionDetectionSystem_IDPS">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:comment>Cybersecurity monitor detecting anomalous CAN/Ethernet frames, unauthorized UDS diagnostic requests, or memory access breaches.</rdfs:comment>
        <rdfs:label>In-Vehicle IDPS</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Investigator -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Investigator">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Actor"/>
        <rdfs:comment>A certified practitioner who acquires, parses, correlates, and analyzes digital evidence from CAV ecosystems.</rdfs:comment>
        <rdfs:label>Digital Forensic Investigator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#LegalAdmissibility -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#LegalAdmissibility">
        <rdfs:comment>Status of evidence meeting statutory legal thresholds (ISO/IEC 27037) for court presentation.</rdfs:comment>
        <rdfs:label>Legal Admissibility</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#LegalRequirement -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#LegalRequirement">
        <rdfs:comment>Statutory mandates, safety standards, or digital evidence regulations governing CAVs.</rdfs:comment>
        <rdfs:label>Legal Requirement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#LiDAR_Optics_Dazzling -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#LiDAR_Optics_Dazzling">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#CyberAttack"/>
        <rdfs:comment>Laser pulse injection blinding optical receivers and generating phantom obstacles.</rdfs:comment>
        <rdfs:label>LiDAR Optical Dazzling / Blinding</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#LidarSensor -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#LidarSensor">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Sensor"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#RadarSensor"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#UltrasonicSensor"/>
        <rdfs:comment>Laser-based sensor capturing 3D point clouds for range determination and spatial mapping.</rdfs:comment>
        <rdfs:label>LiDAR Sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Malware -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Malware">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#CyberAttack"/>
        <rdfs:comment>Unauthorized malicious code executing on an ECU or domain controller.</rdfs:comment>
        <rdfs:label>Malware Infection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#ManeuverCoordination_MCM -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#ManeuverCoordination_MCM">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#V2XMessage"/>
        <rdfs:comment>Cooperative message exchanging planned trajectory intent between autonomous vehicles.</rdfs:comment>
        <rdfs:label>Maneuver Coordination Message (MCM)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Manufacturer -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Manufacturer">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Actor"/>
        <rdfs:comment>The Original Equipment Manufacturer (OEM) responsible for CAV design, firmware signing, and cloud services.</rdfs:comment>
        <rdfs:label>Manufacturer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#NearMiss -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#NearMiss">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Incident"/>
        <rdfs:comment>Event where collision was avoided via sudden fallback maneuver or driver takeover.</rdfs:comment>
        <rdfs:label>Near Miss</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#NonCyberIncident -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#NonCyberIncident">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Incident"/>
        <rdfs:comment>Incidents driven purely by mechanical failure, weather, or road geometry defects.</rdfs:comment>
        <rdfs:label>Non-Cyber Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#NonVolatileMemory -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#NonVolatileMemory">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#DataStorageSystem"/>
        <rdfs:comment>Storage media retaining data through power cycles (eMMC, NVMe, EEPROM).</rdfs:comment>
        <rdfs:label>Non-Volatile Memory</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Occupant -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Occupant">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Actor"/>
        <rdfs:comment>A passenger inside the CAV during an incident.</rdfs:comment>
        <rdfs:label>Occupant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Operator -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Operator">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Actor"/>
        <rdfs:comment>An enterprise managing connected autonomous vehicle fleets or teleoperations infrastructure.</rdfs:comment>
        <rdfs:label>Fleet Operator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Pedestrian -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Pedestrian">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#ByStander"/>
        <rdfs:comment>A vulnerable road user traveling on foot near the CAV incident location.</rdfs:comment>
        <rdfs:label>Pedestrian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#PersonalSafetyMessage_PSM -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#PersonalSafetyMessage_PSM">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#V2XMessage"/>
        <rdfs:comment>V2P message broadcast by pedestrian/cyclist smart devices to prevent VRU collisions.</rdfs:comment>
        <rdfs:label>Personal Safety Message (PSM)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#PhysicalIncident -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#PhysicalIncident">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Incident"/>
        <rdfs:comment>Events involving physical collision, rollover, or mechanical structural impact.</rdfs:comment>
        <rdfs:label>Physical Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#PoliceOfficer -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#PoliceOfficer">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#FirstResponder"/>
        <rdfs:comment>A law enforcement officer responsible for scene security and digital evidence preservation.</rdfs:comment>
        <rdfs:label>Police Officer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#RadarSensor -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#RadarSensor">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Sensor"/>
        <owl:disjointWith rdf:resource="http://www.example.org/cav-df-ontology#UltrasonicSensor"/>
        <rdfs:comment>RF sensor measuring object distance, angle, and Doppler velocity in adverse weather.</rdfs:comment>
        <rdfs:label>Radar Sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Reconstruction -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Reconstruction">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#AnalysisMethod"/>
        <rdfs:comment>Recreating physical/cyber events using fused point clouds, CAN logs, and V2X streams.</rdfs:comment>
        <rdfs:label>Incident Reconstruction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#RoadsideUnit -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#RoadsideUnit">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#ExternalDataSource"/>
        <rdfs:comment>V2I infrastructure transceiver broadcasting SPaT, MAP, and Road Work Warnings.</rdfs:comment>
        <rdfs:label>Roadside Unit (RSU)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#SecureGateway_CGW -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#SecureGateway_CGW">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:comment>Firewalled gateway managing routing and cryptographic translation between internal buses and external TCU/V2X stacks.</rdfs:comment>
        <rdfs:label>Central Security Gateway (CGW)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#SecurityCredentialManagementSystem_SCMS -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#SecurityCredentialManagementSystem_SCMS">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#ExternalDataSource"/>
        <rdfs:comment>V2X PKI authority issuing and validating pseudonym certificates and Certificate Revocation Lists (CRLs).</rdfs:comment>
        <rdfs:label>Security Credential Management System (SCMS)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#Sensor -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#Sensor">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#AVSystemComponent"/>
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#InternalDataSource"/>
        <rdfs:comment>Hardware perceiving physical environmental state and feeding signals into the perception stack.</rdfs:comment>
        <rdfs:label>Sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#SensorFusionAnomaly -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#SensorFusionAnomaly">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#Incident"/>
        <rdfs:comment>Classification jitter, false-positive phantom braking, or ghost target creation causing improper action.</rdfs:comment>
        <rdfs:label>Sensor Fusion / Perception Failure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#SensorSpoofing -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#SensorSpoofing">
        <rdfs:subClassOf rdf:resource="http://www.example.org/cav-df-ontology#CyberAttack"/>
        <rdfs:comment>Adversarial injection of false sensor telemetry to deceive perception and path planning.</rdfs:comment>
        <rdfs:label>Sensor Spoofing</rdfs:label>
    </owl:Class>
    


