    </owl:NamedIndividual>
    


    <!-- http://www.example.org/cav-df-ontology#Crash_Incident_20260315 -->

    <owl:NamedIndividual rdf:about="http://www.example.org/cav-df-ontology#Crash_Incident_20260315">
