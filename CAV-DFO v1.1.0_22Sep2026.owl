        <rdfs:label>V2X Protocol (DSRC / C-V2X)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/cav-df-ontology#VehicleCrash -->

    <owl:Class rdf:about="http://www.example.org/cav-df-ontology#VehicleCrash">
