        <rdf:type rdf:resource="http://www.example.org/cav-df-ontology#Assertion"/>
        <isSupportedBy rdf:resource="http://www.example.org/cav-df-ontology#Exculpatory_V2I_Evidence"/>
        <isSupportedBy rdf:resource="http://www.example.org/cav-df-ontology#Inculpatory_Braking_Evidence"/>
        <hasConfidenceLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.95</hasConfidenceLevel>
        <hasDescription>Assertion that corrupted V2I SPaT timing directly induced trajectory planning error.</hasDescription>
        <rdfs:label>Assertion_CorruptedV2I</rdfs:label>
    </owl:NamedIndividual>
    


