        <hasTimestamp rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2026-03-15T10:30:05.000Z</hasTimestamp>
        <rdfs:label>Crash_Incident_20260315</rdfs:label>
    </owl:NamedIndividual>
    


